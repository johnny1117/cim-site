# ====== Variáveis de ambiente do site CIM ======
# Copie estes nomes para o Vercel (Project Settings > Environment Variables)
# e para um arquivo .env local (não versionado) se for testar na sua máquina.

# URL do projeto Supabase (pública)
SUPABASE_URL=https://qlaoissrkpjifxenimvx.supabase.co

# Chave service_role do Supabase (SECRETA — nunca exponha no front-end nem no Git)
# Onde pegar: Supabase > seu projeto > Project Settings > API > "service_role" (Reveal)
SUPABASE_SERVICE_ROLE_KEY=

# Segredo para assinar o cookie de login (qualquer string longa e aleatória)
# Gere uma, por exemplo, com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Ambiente (em produção use "production" para o cookie seguro funcionar)
NODE_ENV=production
