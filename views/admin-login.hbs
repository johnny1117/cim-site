<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login — Painel CIM</title>
  <link rel="icon" href="/arquivos logo/LOGO DO CIM.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;500;600;700;800;900&family=Source+Sans+3:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css?v={{assetV}}">
</head>
<body>
  <div class="login-wrap">
    <div class="login-card">
      <img class="logo" src="/arquivos logo/LOGO DO CIM.png" alt="Logo CIM-UFPB">
      <h1>Painel CIM</h1>
      <div class="sub">Centro de Informação sobre Medicamentos</div>

      {{#if error}}
      <div class="login-error">Usuário ou senha incorretos.</div>
      {{/if}}

      <form action="/admin/login" method="POST">
        <div class="fg">
          <label for="username">Usuário</label>
          <input type="text" id="username" name="username" placeholder="Digite seu usuário" required autofocus autocomplete="username">
        </div>
        <div class="fg">
          <label for="password">Senha</label>
          <input type="password" id="password" name="password" placeholder="Digite sua senha" required autocomplete="current-password">
        </div>
        <button type="submit" class="btn btn-primary">Acessar painel</button>
      </form>

      <a href="/" class="login-back">← Voltar ao site</a>
    </div>
  </div>
</body>
</html>
