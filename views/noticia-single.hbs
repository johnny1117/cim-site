<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{#if news}}{{news.title}}{{else}}Notícia{{/if}} — CIM-UFPB</title>
<meta name="description" content="{{#if news}}{{news.subtitle}}{{else}}Centro de Informação sobre Medicamentos da UFPB.{{/if}}">
<meta property="og:type" content="article">
<meta property="og:title" content="{{#if news}}{{news.title}}{{/if}}">
<meta property="og:description" content="{{#if news}}{{news.subtitle}}{{/if}}">
{{#if news.mainImage.url}}<meta property="og:image" content="{{news.mainImage.url}}">{{/if}}
<link rel="icon" href="/arquivos logo/LOGO DO CIM.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;500;600;700;800;900&family=Source+Sans+3:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/site.css?v={{assetV}}">
<script>(function(){try{var t=localStorage.getItem('cim-theme');if(t)document.documentElement.setAttribute('data-theme',t);}catch(e){}})();</script>
</head>
<body>

<!-- NAVBAR -->
<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href="/" aria-label="Página inicial do CIM-UFPB">
      <img src="/arquivos logo/LOGO DO CIM.png" alt="Logo CIM-UFPB">
      <span class="brand-text">CIM<small>Informação sobre Medicamentos</small></span>
    </a>
    <nav class="nav-links" aria-label="Navegação principal">
      <a href="/">Início</a>
      <a href="/noticias">Notícias</a>
      <a href="/breaking-news">Breaking News</a>
      <a href="/videos">Vídeos</a>
      <a href="/projetos">Projetos</a>
      <a href="/sobre">Sobre</a>
    </nav>
    <div class="nav-tools">
      <button class="icon-btn" data-theme-icon onclick="toggleTheme()" aria-label="Alternar tema">
        <svg class="icon ic-moon" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/></svg>
        <svg class="icon ic-sun" style="display:none" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>
      </button>
      <button class="icon-btn nav-toggle" onclick="toggleMenu()" aria-label="Abrir menu">
        <svg class="icon" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobileMenu">
  <div class="scrim"></div>
  <div class="panel">
    <div class="mm-head"><span class="brand-text">CIM</span>
      <button class="icon-btn" data-close aria-label="Fechar menu"><svg class="icon" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
    </div>
    <a href="/">Início</a>
    <a href="/noticias">Notícias</a>
    <a href="/breaking-news">Breaking News</a>
    <a href="/videos">Vídeos</a>
    <a href="/projetos">Projetos</a>
    <a href="/sobre">Sobre</a>
  </div>
</div>

{{#if news}}
<article class="article">
  <div class="breadcrumb" style="margin-bottom:18px;font-size:.82rem;color:var(--muted);display:flex;gap:8px;flex-wrap:wrap;">
    <a href="/">Início</a><span class="sep" style="opacity:.5">/</span>
    <a href="/noticias">Notícias</a><span class="sep" style="opacity:.5">/</span>
    <span>{{news.title}}</span>
  </div>

  <div class="article-tags">
    {{#each news.tags}}<span class="chip green">{{this}}</span>{{/each}}
  </div>

  <h1>{{news.title}}</h1>
  {{#if news.subtitle}}<p class="dek">{{news.subtitle}}</p>{{/if}}

  <div class="article-meta">
    {{#if news.author}}<span class="mi">{{#if news.authorImage}}<img src="{{news.authorImage}}" alt="{{news.author}}" class="author-icon">{{else}}<svg class="icon" viewBox="0 0 24 24"><path d="M20 21a8 8 0 10-16 0"/><circle cx="12" cy="7" r="4"/></svg>{{/if}} Por <strong>{{news.author}}</strong></span>{{/if}}
    <span class="mi"><svg class="icon" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg> {{news.date}}</span>
  </div>

  {{#if news.mainImage.url}}
  <figure class="article-figure">
    <img src="{{news.mainImage.url}}" alt="{{news.title}}">
    {{#if news.mainImage.description}}<figcaption>{{news.mainImage.description}}</figcaption>{{/if}}
  </figure>
  {{/if}}

  <div class="article-body">
    {{{news.bodyHtml}}}
  </div>

  <div class="article-divider"></div>

  <div class="share">
    <span>Compartilhar:</span>
    <button class="share-btn" title="WhatsApp" onclick="window.open('https://wa.me/?text=' + encodeURIComponent(document.title + ' - ' + window.location.href), '_blank')" aria-label="Compartilhar no WhatsApp">
      <svg class="icon" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    </button>
    <button class="share-btn" title="Copiar link" onclick="navigator.clipboard.writeText(window.location.href);this.classList.add('ok');setTimeout(()=>this.classList.remove('ok'),1500)" aria-label="Copiar link">
      <svg class="icon" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
    </button>
  </div>
</article>
{{else}}
<div class="article" style="text-align:center;padding-top:80px;padding-bottom:80px;">
  <h1>Notícia não encontrada</h1>
  <p class="dek">O conteúdo que você procura não existe ou foi removido.</p>
  <a href="/noticias" class="btn btn-primary" style="margin-top:8px;">Ver todas as notícias</a>
</div>
{{/if}}

<!-- FOOTER -->
<footer class="footer" id="contato" style="margin-top:48px;">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-brand">
          <img src="/arquivos logo/LOGO DO CIM BRANCO.png" alt="Logo CIM-UFPB">
          <span class="ftxt">CIM-UFPB<small>Informação sobre Medicamentos</small></span>
        </div>
        <p class="footer-about">O Centro de Informação sobre Medicamentos da UFPB promove o uso racional de medicamentos por meio de informação técnico-científica, educação em saúde e apoio à decisão clínica.</p>
      </div>
      <div>
        <h4>Conteúdo</h4>
        <ul>
          <li><a href="/noticias">Notícias</a></li>
          <li><a href="/breaking-news">Breaking News</a></li>
          <li><a href="/videos">Vídeos</a></li>
          <li><a href="/projetos">Projetos</a></li>
          <li><a href="/sobre">Sobre Nós</a></li>
        </ul>
      </div>
      <div>
        <h4>Fale Conosco</h4>
        <div class="footer-contact">
          <a href="https://www.instagram.com/cimufpb/" target="_blank" rel="noopener"><svg class="icon" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>@cimufpb</a>
          <a href="mailto:cimufpb@gmail.com"><svg class="icon" viewBox="0 0 24 24"><path d="M4 6h16v12H4z"/><path d="M4 7l8 6 8-6"/></svg>cimufpb@gmail.com</a>
          <span><svg class="icon" viewBox="0 0 24 24"><path d="M12 21s-7-6.3-7-11a7 7 0 0114 0c0 4.7-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>Dep. de Ciências Farmacêuticas, UFPB</span>
        </div>
      </div>
    </div>
    <div class="footer-bottom">© 2026 Centro de Informação sobre Medicamentos — Universidade Federal da Paraíba. Todos os direitos reservados.</div>
  </div>
</footer>

<script src="/js/site.js?v={{assetV}}"></script>
</body>
</html>
