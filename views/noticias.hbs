<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Notícias — CIM-UFPB</title>
<meta name="description" content="Notícias, breaking news e vídeos do Centro de Informação sobre Medicamentos da UFPB.">
<link rel="icon" href="/arquivos logo/LOGO DO CIM.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;500;600;700;800;900&family=Source+Sans+3:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/site.css?v={{assetV}}">
<script>(function(){try{var t=localStorage.getItem('cim-theme');if(t)document.documentElement.setAttribute('data-theme',t);}catch(e){}})();</script>
</head>
<body>

<!-- NAVBAR -->
<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href="/" aria-label="Página inicial do CIM-UFPB">
      <img src="/arquivos logo/LOGO DO CIM.png" alt="Logo CIM-UFPB">
      <span class="brand-text">CIM<small>Informação sobre Medicamentos</small></span>
    </a>
    <nav class="nav-links" aria-label="Navegação principal">
      <a href="/">Início</a>
      <a href="/noticias" class="{{#if activeTabNoticias}}active{{/if}}">Notícias</a>
      <a href="/breaking-news" class="{{#if activeTabBreaking}}active{{/if}}">Breaking News</a>
      <a href="/videos" class="{{#if activeTabVideos}}active{{/if}}">Vídeos</a>
      <a href="/projetos">Projetos</a>
      <a href="/sobre">Sobre</a>
    </nav>
    <div class="nav-tools">
      <button class="icon-btn" data-theme-icon onclick="toggleTheme()" aria-label="Alternar tema">
        <svg class="icon ic-moon" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/></svg>
        <svg class="icon ic-sun" style="display:none" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>
      </button>
      <button class="icon-btn nav-toggle" onclick="toggleMenu()" aria-label="Abrir menu">
        <svg class="icon" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobileMenu">
  <div class="scrim"></div>
  <div class="panel">
    <div class="mm-head"><span class="brand-text">CIM</span>
      <button class="icon-btn" data-close aria-label="Fechar menu"><svg class="icon" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
    </div>
    <a href="/">Início</a>
    <a href="/noticias">Notícias</a>
    <a href="/breaking-news">Breaking News</a>
    <a href="/videos">Vídeos</a>
    <a href="/projetos">Projetos</a>
    <a href="/sobre">Sobre</a>
  </div>
</div>

<!-- BANNER -->
<section class="page-banner">
  <div class="container">
    <span class="kicker">Conteúdo</span>
    <h1>{{#if activeTabVideos}}Vídeos{{else if activeTabBreaking}}Breaking News{{else}}Notícias{{/if}}</h1>
    <div class="breadcrumb">
      <a href="/">Início</a><span class="sep">/</span>
      <span>{{#if activeTabVideos}}Vídeos{{else if activeTabBreaking}}Breaking News{{else}}Notícias{{/if}}</span>
    </div>
  </div>
</section>

<div class="container list-wrap">

  <form class="search-bar" action="/{{#if activeTabVideos}}videos{{else if activeTabBreaking}}breaking-news{{else}}noticias{{/if}}" method="GET">
    <input type="text" name="q" placeholder="Pesquisar por título ou tag..." value="{{q}}">
    <button type="submit" class="btn btn-primary">Buscar</button>
  </form>

  <nav class="tabs" aria-label="Categorias">
    <a href="/noticias{{#if q}}?q={{q}}{{/if}}" class="tab {{#if activeTabNoticias}}active{{/if}}">Notícias</a>
    <a href="/breaking-news{{#if q}}?q={{q}}{{/if}}" class="tab {{#if activeTabBreaking}}active{{/if}}">Breaking News</a>
    <a href="/videos{{#if q}}?q={{q}}{{/if}}" class="tab {{#if activeTabVideos}}active{{/if}}">Vídeos</a>
  </nav>

  {{#if activeTabNoticias}}
  <div class="list">
    {{#if news.length}}
      {{#each news}}
      <a href="/news/{{this.id}}" class="row">
        {{#if this.mainImage.url}}
        <img src="{{this.mainImage.url}}" alt="{{this.title}}" class="row-thumb">
        {{else}}
        <div class="row-thumb ph"><svg class="icon" viewBox="0 0 24 24"><path d="M4 19.5V6a2 2 0 012-2h9l5 5v10.5a1.5 1.5 0 01-1.5 1.5h-12A1.5 1.5 0 014 19.5z"/><path d="M14 4v5h5"/></svg></div>
        {{/if}}
        <div class="row-body">
          <div class="row-tags">{{#each this.tags}}<span class="chip green">{{this}}</span>{{/each}}</div>
          <h2>{{this.title}}</h2>
          <p>{{this.subtitle}}</p>
          <div class="row-meta">{{this.date}}{{#if this.author}} • {{this.author}}{{/if}}</div>
        </div>
      </a>
      {{/each}}
    {{else}}
      <p class="empty">Nenhuma notícia encontrada.</p>
    {{/if}}
  </div>
  {{/if}}

  {{#if activeTabBreaking}}
  <div class="list">
    {{#if breakingNews.length}}
      {{#each breakingNews}}
      <a href="/news/breaking/{{this.id}}" class="row">
        {{#if this.mainImage.url}}
        <img src="{{this.mainImage.url}}" alt="{{this.title}}" class="row-thumb">
        {{else}}
        <div class="row-thumb ph red"><svg class="icon" viewBox="0 0 24 24"><path d="M13 2L3 14h8l-1 8 10-12h-8z"/></svg></div>
        {{/if}}
        <div class="row-body">
          <div class="row-tags">{{#each this.tags}}<span class="chip red">{{this}}</span>{{/each}}</div>
          <h2>{{this.title}}</h2>
          <p>{{this.subtitle}}</p>
          <div class="row-meta">{{this.date}}{{#if this.author}} • {{this.author}}{{/if}}</div>
        </div>
      </a>
      {{/each}}
    {{else}}
      <p class="empty">Nenhum breaking news encontrado.</p>
    {{/if}}
  </div>
  {{/if}}

  {{#if activeTabVideos}}
  <div class="list">
    {{#if videos.length}}
      {{#each videos}}
      <a href="{{this.link}}" target="_blank" rel="noopener" class="row">
        {{#if this.mainImage.url}}
        <div style="position:relative;width:220px;height:150px;flex-shrink:0;">
          <img src="{{this.mainImage.url}}" alt="{{this.title}}" class="row-thumb">
          <div class="row-play"><svg class="icon" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
        </div>
        {{else}}
        <div class="row-thumb ph"><svg class="icon" viewBox="0 0 24 24"><path d="M4 6a2 2 0 012-2h12a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2z"/><path d="M10 9l5 3-5 3z"/></svg></div>
        {{/if}}
        <div class="row-body">
          <div class="row-tags">{{#each this.tags}}<span class="chip">{{this}}</span>{{/each}}</div>
          <h2>{{this.title}}</h2>
          <p>{{this.subtitle}}</p>
          <div class="row-meta">{{this.date}}{{#if this.duration}} • {{this.duration}}{{/if}}</div>
        </div>
      </a>
      {{/each}}
    {{else}}
      <p class="empty">Nenhum vídeo encontrado.</p>
    {{/if}}
  </div>
  {{/if}}

  <div class="pagination">
    {{#if hasPrev}}
    <a href="/{{#if activeTabVideos}}videos{{else if activeTabBreaking}}breaking-news{{else}}noticias{{/if}}?page={{prevPage}}{{#if q}}&q={{q}}{{/if}}">
      <svg class="icon" viewBox="0 0 24 24" style="width:16px;height:16px"><path d="M15 18l-6-6 6-6"/></svg> Anterior
    </a>
    {{/if}}
    <span class="current">Página {{currentPage}} de {{totalPages}}</span>
    {{#if hasNext}}
    <a href="/{{#if activeTabVideos}}videos{{else if activeTabBreaking}}breaking-news{{else}}noticias{{/if}}?page={{nextPage}}{{#if q}}&q={{q}}{{/if}}">
      Próxima <svg class="icon" viewBox="0 0 24 24" style="width:16px;height:16px"><path d="M9 6l6 6-6 6"/></svg>
    </a>
    {{/if}}
  </div>
</div>

<!-- FOOTER -->
<footer class="footer" id="contato">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-brand">
          <img src="/arquivos logo/LOGO DO CIM BRANCO.png" alt="Logo CIM-UFPB">
          <span class="ftxt">CIM-UFPB<small>Informação sobre Medicamentos</small></span>
        </div>
        <p class="footer-about">O Centro de Informação sobre Medicamentos da UFPB promove o uso racional de medicamentos por meio de informação técnico-científica, educação em saúde e apoio à decisão clínica.</p>
      </div>
      <div>
        <h4>Conteúdo</h4>
        <ul>
          <li><a href="/noticias">Notícias</a></li>
          <li><a href="/breaking-news">Breaking News</a></li>
          <li><a href="/videos">Vídeos</a></li>
          <li><a href="/projetos">Projetos</a></li>
          <li><a href="/sobre">Sobre Nós</a></li>
        </ul>
      </div>
      <div>
        <h4>Fale Conosco</h4>
        <div class="footer-contact">
          <a href="https://www.instagram.com/cimufpb/" target="_blank" rel="noopener"><svg class="icon" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>@cimufpb</a>
          <a href="mailto:cimufpb@gmail.com"><svg class="icon" viewBox="0 0 24 24"><path d="M4 6h16v12H4z"/><path d="M4 7l8 6 8-6"/></svg>cimufpb@gmail.com</a>
          <span><svg class="icon" viewBox="0 0 24 24"><path d="M12 21s-7-6.3-7-11a7 7 0 0114 0c0 4.7-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>Dep. de Ciências Farmacêuticas, UFPB</span>
        </div>
      </div>
    </div>
    <div class="footer-bottom">© 2026 Centro de Informação sobre Medicamentos — Universidade Federal da Paraíba. Todos os direitos reservados.</div>
  </div>
</footer>

<script src="/js/site.js?v={{assetV}}"></script>
</body>
</html>
